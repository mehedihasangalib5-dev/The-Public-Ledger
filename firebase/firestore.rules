rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isStaff() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }
    function isAdmin() {
      return isStaff() &&
        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'admin';
    }

    // বিভাগ — সবাই পড়তে পারবে, শুধু অ্যাডমিন লিখতে পারবে
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // প্রতিবেদন — যেকেউ শুধু "published" প্রতিবেদন পড়তে পারবে,
    // স্টাফরা (রিপোর্টার + অ্যাডমিন) সবকিছু পড়তে/লিখতে পারবে,
    // ডিলিট শুধু অ্যাডমিন করতে পারবে
    match /articles/{articleId} {
      allow read: if resource.data.status == 'published';
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // মিডিয়া লাইব্রেরি — শুধু স্টাফরা পড়তে/লিখতে পারবে
    match /media/{mediaId} {
      allow read, write: if isStaff();
    }

    // স্টাফ তালিকা — নিজের রেকর্ড নিজে পড়তে পারবে (লগইনের সময় role চেক করতে),
    // বাকি সব শুধু অ্যাডমিন করতে পারবে
    match /staff/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }
  }
}
